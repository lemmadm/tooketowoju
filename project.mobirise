                    "margin-bottom": "30px"
                  }
                },
                ".mbr-link": {
                  "margin-bottom": "0"
                },
                ".mbr-desc": {
                  "margin-bottom": "0"
                },
                ".mbr-section-btn": {
                  "margin-top": "40px",
                  "@media (max-width: 992px)": {
