              "img": {
                "& when (@showBorder)": {
                  "border-radius": "2rem",
                  "padding": "5px",
                  "background-color": "@borderColor"
                },
                "height": "550px",
                "width": "100%",
                "object-fit": "cover",
                "@media (max-width: 992px)": {
