              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "padding": "10px 8px"
              }
            },
            ".row": {
              "margin": "0",
              ".card": {
                "padding": "0",
                "&:nth-child(2n)": {
                  ".item-wrapper": {
                    "margin-right": "0"
                  }
                }
              }
            },
            ".item-wrapper": {
              "display": "flex",
              "align-items": "center",
              "padding": "50px 40px",
              "background-color": "@container",
              "border-radius": "25px",
              "margin-right": "16px",
              "height": "100%",
              "@media (max-width: 992px)": {
                "margin": "0 0 16px 0"
              },
              "@media (max-width: 768px)": {
